{
  "name": "sme-scanner-visibility-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "displayName": "SME Scanner Visibility Workspace",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && corepack pnpm -r typecheck",
    "test": "vitest run && corepack pnpm -r test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "test:secret-boundary": "node scripts/assert-secret-boundary.mjs",
    "db:verify": "bash supabase/verify-migrations.sh",
    "db:types": "tsx scripts/gen-types.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@sme-scanner/contracts": "workspace:*",
    "@sme-scanner/region": "workspace:*",
    "@sme-scanner/scan-engine": "workspace:*",
    "@sme-scanner/scoring": "workspace:*",
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.106.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "image-size": "2.0.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  }
}
