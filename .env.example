# Neon target NOT CHOSEN; preparation is not hosted operation authorization. See docs/integration/NEON-CUTOVER.md.
# PostgreSQL: pooled restricted app LOGIN role for runtime; same-branch direct migration role only in authorized operator processes.
# Never deploy DATABASE_URL_UNPOOLED to the web runtime. Readiness receives both URLs in its separate read-only process.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon managed Auth: selected branch Auth endpoint, never a database URL.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=                                      # distinct random secret, at least 32 characters
# Explicit nonsecret expected target for read-only readiness. Hosted target NOT CHOSEN.
NEON_READINESS_HOST=
NEON_READINESS_DATABASE=
# Evidence providers                                           — optional; missing → module 'unavailable' (never 'failed')
RAPIDAPI_INSTAGRAM_KEY=
RAPIDAPI_INSTAGRAM_SEARCH_PATH=                                # default search_ig.php
GOOGLE_PLACES_KEY=
SERPAPI_API_KEY=                                               # preferred name; SERPAPI_KEY is the legacy alias of the same key
SERPAPI_KEY=
SERPAPI_API_KEY_FALLBACK=                                      # a different key on its own quota
EVIDENCE_SNAPSHOT_INSTAGRAM_ALLOWED=false                      # exactly "true" enables snapshot retention
EVIDENCE_SNAPSHOT_GOOGLE_MAPS_ALLOWED=false
# LLM gateway (precedence: OPENCODE_API_KEY → LLM_API_KEY → OPENROUTER_KEY; LLM_BASE_URL/LLM_MODEL optional) — llmComplete returns null without a key
OPENCODE_API_KEY=
LLM_API_KEY=
OPENROUTER_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_COST_PER_1K_INPUT_TOKENS_USD=0.0002
LLM_COST_PER_1K_OUTPUT_TOKENS_USD=0.0008
NEXT_PUBLIC_APP_URL=                                           # LLM HTTP-Referer only
# App origin & locale
NEXT_PUBLIC_SITE_URL=                                          # absolute origin, no trailing slash (canonical, OG, share)
APP_ORIGIN=                                                    # required: every mailed link, Stripe URLs, auth callbacks; https, no path
NEXT_PUBLIC_REGION=                                            # unset = all three locales; hk | tw filters served locales
NEXT_PUBLIC_HK_WHATSAPP_NUMBER=                                # E.164 +852…
NEXT_PUBLIC_HK_PHONE_NUMBER=
NEXT_PUBLIC_HK_CONTACT_EMAIL=
NEXT_PUBLIC_TW_LINE_URL=                                       # https://line.me/…
NEXT_PUBLIC_TW_PHONE_NUMBER=
NEXT_PUBLIC_TW_CONTACT_EMAIL=
# Security (fail closed)
RATE_LIMIT_SECRET=                                             # required outside tests; every rate-limited route 503s without it
REPORT_ACCESS_TOKEN_SECRET=                                    # ≥ 32 bytes in production
OAUTH_TOKEN_ENCRYPTION_KEY=                                    # base64, ≥ 32 bytes in production
CRON_SECRET=                                                   # ≥ 16 chars; only if this app ever exposes cron/worker callbacks
SCAN_EXECUTION_RUNTIME=                                        # vercel selected; scheduled/cloudflare resolve to Vercel; direct external dispatch blocked
SCAN_WORKER_URL=                                               # reserved bare https origin; cannot bypass current external-dispatch block
# Report delivery, recovery, notifications
REPORT_RECOVERY_ENABLED=false                                  # not read by any code; no recovery route or mail sender exists. Reserved for a future bounded delivery check.
REPORT_EMAIL_FROM=
RESEND_API_KEY=
REPORT_CONSENT_POLICY_VERSION=                                 # leave blank (policy constant 2026-07-28)
# Ownership & Google business OAuth (separate from managed Auth Google sign-in registration)
# Configure managed login mail and Google sign-in in the selected branch Auth settings; no hosted target/recipients chosen.
# Register the chosen APP_ORIGIN with Neon Auth before hosted acceptance.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=                                     # <APP_ORIGIN>/api/oauth/google/callback (registered byte-exact in GCP)
GOOGLE_OAUTH_CLAIM_REDIRECT_URI=                               # <APP_ORIGIN>/api/oauth/google/claim/callback
WORKSPACE_CLAIM_VIA_OAUTH_ENABLED=false                        # exactly "true" opens the claim routes
# OWNER_SELF_SERVICE_CLAIM — never set (CLAUDE.md guardrail 15)
# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_HK_TIER_PRICE_ID=
STRIPE_TW_TIER_PRICE_ID=
# This app
SCAN_SOURCES=live                                              # live | fixture
# Demo seed: corepack pnpm seed:demo --owned-test only; creates/verifies/destroys its own disposable local PostgreSQL fixture.
# Ambient DB URLs are ignored; no production demo data or managed Auth seeding. SEED_DEMO_ALLOW is obsolete.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Workspace completion recovery — leave disabled until immutable Neon migrations 0001-0004,
# hosted schema/runtime checks and same-database retained-scheduler forwarding pass.
WORKSPACE_COMPLETION_ENABLED=false
WORKSPACE_COMPLETION_SECRET=                                  # dedicated random >=32-byte bearer secret; server-only
# WORKSPACE_COMPLETION_ORIGIN belongs to the retained legacy caller, not this app.
