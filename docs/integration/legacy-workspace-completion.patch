@@ -0,0 +1,59 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+vi.mock("server-only", () => ({}));
+import { forwardWorkspaceCompletion } from "./completion-forward";
+
+const config = { WORKSPACE_COMPLETION_ENABLED: "true", WORKSPACE_COMPLETION_SECRET: "fixture-only-completion-secret-32bytes", WORKSPACE_COMPLETION_ORIGIN: "https://workspace.example.test" };
+afterEach(() => vi.restoreAllMocks());
+describe("completion forwarding with injected transport only", () => {
+  it("defaults off without provider or network I/O", async () => {
+    const transport = vi.fn();
+    expect(await forwardWorkspaceCompletion({ reconcile: true }, {}, transport)).toBe("disabled");
+    expect(transport).not.toHaveBeenCalled();
+  });
+  it.each(["http://workspace.example.test", "https://u:p@workspace.example.test", "https://workspace.example.test/path", "https://workspace.example.test?x=1", "https://workspace.example.test#x", "invalid"])("fails closed for invalid origin %s", async origin => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    const transport = vi.fn();
+    expect(await forwardWorkspaceCompletion({ reconcile: true }, { ...config, WORKSPACE_COMPLETION_ORIGIN: origin }, transport)).toBe("retry");
+    expect(transport).not.toHaveBeenCalled();
+  });
+  it("rejects missing and short dedicated secrets", async () => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    const transport = vi.fn();
+    for (const secret of [undefined, "short"]) {
+      expect(await forwardWorkspaceCompletion({ reconcile: true }, { ...config, WORKSPACE_COMPLETION_SECRET: secret }, transport)).toBe("retry");
+    }
+    expect(transport).not.toHaveBeenCalled();
+  });
+  it.each([200, 202])("accepts only the completion acknowledgement %s with bounded manual-redirect transport", async status => {
+    const transport = vi.fn().mockResolvedValue(Response.json({ status: status === 202 ? "busy" : "completed" }, { status }));
+    expect(await forwardWorkspaceCompletion({ jobId: "fixture-job" }, config, transport)).toBe("accepted");
+    expect(transport).toHaveBeenCalledWith("https://workspace.example.test/api/internal/workspace-scan-completion", expect.objectContaining({
+      method: "POST", redirect: "manual", cache: "no-store", signal: expect.any(AbortSignal),
+      headers: { authorization: `Bearer ${config.WORKSPACE_COMPLETION_SECRET}`, "content-type": "application/json" },
+      body: JSON.stringify({ jobId: "fixture-job" }),
+    }));
+  });
+  it.each([302, 401, 404, 503])("defers %s without following redirects or retrying collectors", async status => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    const transport = vi.fn().mockResolvedValue(new Response(null, { status }));
+    expect(await forwardWorkspaceCompletion({ reconcile: true }, config, transport)).toBe("retry");
+    expect(transport).toHaveBeenCalledTimes(1);
+  });
+  it("contains a transport failure", async () => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    expect(await forwardWorkspaceCompletion({ reconcile: true }, config, vi.fn().mockRejectedValue(new Error("fixture timeout")))).toBe("retry");
+  });
+  it.each([new Response(null, { status: 200 }), new Response("<html>wrong app</html>", { status: 200 }), Response.json({ status: "retry" }), Response.json({ status: "completed" }, { status: 202 })])("rejects invalid job success acknowledgement", async response => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    expect(await forwardWorkspaceCompletion({ jobId: "fixture-job" }, config, vi.fn().mockResolvedValue(response.clone()))).toBe("retry");
+  });
+  it("validates the bounded reconciliation result contract", async () => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    for (const body of [{ results: [] }, { results: [{ status: "completed" }, { status: "busy" }, { status: "skipped" }] }]) {
+      expect(await forwardWorkspaceCompletion({ reconcile: true }, config, vi.fn().mockResolvedValue(Response.json(body)))).toBe("accepted");
+    }
+    for (const body of [{}, { results: "done" }, { results: [{ status: "retry" }] }, { results: Array(6).fill({ status: "completed" }) }]) {
+      expect(await forwardWorkspaceCompletion({ reconcile: true }, config, vi.fn().mockResolvedValue(Response.json(body)))).toBe("retry");
+    }
+  });
+});
diff --git a/apps/web/lib/workspace/completion-forward.ts b/apps/web/lib/workspace/completion-forward.ts
new file mode 100644
index 0000000..bb12b42
--- /dev/null
+++ b/apps/web/lib/workspace/completion-forward.ts
@@ -0,0 +1,45 @@
+import "server-only";
+
+export type CompletionRequest = { jobId: string } | { reconcile: true };
+export type ForwardOutcome = "disabled" | "accepted" | "retry";
+
+/** Dedicated server-to-server recovery; never collects scans or sends email. */
+export async function forwardWorkspaceCompletion(
+  input: CompletionRequest,
+  env: NodeJS.ProcessEnv = process.env,
+  transport: typeof fetch = fetch,
+): Promise<ForwardOutcome> {
+  if (env.WORKSPACE_COMPLETION_ENABLED !== "true") return "disabled";
+  try {
+    const secret = env.WORKSPACE_COMPLETION_SECRET;
+    if (!secret || Buffer.byteLength(secret, "utf8") < 32) throw new Error("invalid configuration");
+    const origin = new URL(env.WORKSPACE_COMPLETION_ORIGIN ?? "");
+    if (origin.protocol !== "https:" || origin.username || origin.password || origin.pathname !== "/" || origin.search || origin.hash) {
+      throw new Error("invalid configuration");
+    }
+    const response = await transport(`${origin.origin}/api/internal/workspace-scan-completion`, {
+      method: "POST", redirect: "manual", cache: "no-store",
+      headers: { authorization: `Bearer ${secret}`, "content-type": "application/json" },
+      body: JSON.stringify(input), signal: AbortSignal.timeout(5_000),
+    });
+    // 202 means another worker owns the lease. Existing scheduler ticks retry
+    // it; the scan itself must never be dispatched again to repair completion.
+    if (response.status !== 200 && response.status !== 202) throw new Error("completion rejected");
+    const result: unknown = await response.json();
+    if (!result || typeof result !== "object") throw new Error("invalid acknowledgement");
+    const body = result as Record<string, unknown>;
+    if ("jobId" in input) {
+      const valid = response.status === 202 ? body.status === "busy" : body.status === "completed" || body.status === "skipped";
+      if (!valid) throw new Error("invalid acknowledgement");
+    } else {
+      if (response.status !== 200 || !Array.isArray(body.results) || body.results.length > 5 || !body.results.every(row =>
+        row && typeof row === "object" && ["completed", "busy", "skipped"].includes((row as Record<string, unknown>).status as string))) {
+        throw new Error("invalid acknowledgement");
+      }
+    }
+    return "accepted";
+  } catch {
+    console.error("[workspace/completion-forward] deferred", { category: "workspace_completion_forward_failed" });
+    return "retry";
+  }
+}
